{
  "$id": "https://systems-atlas.local/schemas/gate-result.schema.json",
  "title": "atlas-lab gate test result; POST /api/runner/results with kind=gate_tests",
  "$comment": "Generated from apps/web/modules/research/internal/contract.ts. Also enforced server-side: bundle_sha256 equals the current bundle; the test names equal the bundle's test list.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "bundle": {
      "type": "string",
      "pattern": "^atlas-lab:[a-z0-9-]+@[0-9]+$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "results": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
          },
          "passed": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "test",
          "passed",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "docker": {
      "type": "object",
      "properties": {
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "network": {
          "type": "string",
          "const": "none"
        }
      },
      "required": [
        "image_digest",
        "network"
      ],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "libs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 100
          }
        },
        "git_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_dirty": {
          "type": "boolean"
        },
        "container_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "memory_mb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "driver": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "cuda": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 50
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "memory_mb",
              "driver",
              "cuda"
            ],
            "additionalProperties": false
          }
        },
        "gpu_topology": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "cpu",
        "cpu_count",
        "os",
        "python",
        "libs",
        "git_sha",
        "container_digest",
        "gpu"
      ],
      "additionalProperties": false
    },
    "runner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema_version",
    "bundle",
    "bundle_sha256",
    "results",
    "docker",
    "env",
    "runner_version",
    "started_at",
    "ended_at"
  ],
  "additionalProperties": false
}
